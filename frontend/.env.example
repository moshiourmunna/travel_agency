# Musafir public site (Next.js). Copy to .env.local
# Laravel API base (server-side only)
API_URL=http://127.0.0.1:8000
# Public URL of this site (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Must equal REVALIDATE_SECRET in backend/.env
REVALIDATE_SECRET=local-dev-secret-change-me
# Extra image/media origins for the Content-Security-Policy (CDN, S3), space or comma separated. API_URL is always allowed.
# Read at build time: rebuild after changing.
MEDIA_ORIGINS=

# standalone → .next/standalone/server.js for Passenger/cPanel Node apps, Docker, PaaS (leave empty for `next start`)
NEXT_OUTPUT=
