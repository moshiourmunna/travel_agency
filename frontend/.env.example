# Musafir public site (Next.js). Copy to .env.local
# Laravel API base (server-side only)
API_URL=http://127.0.0.1:8000
# Public URL of this site (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Must equal REVALIDATE_SECRET in backend/.env
REVALIDATE_SECRET=local-dev-secret-change-me
