# Musafir API + admin (Laravel). Copy to .env, then: php artisan key:generate
APP_NAME=Musafir
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Public URL of this Laravel app (media URLs are built from it)
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8.4 (Laragon default: root without password)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=musafir
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Production: redis for both (see docs/DEPLOYMENT.md)
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local: e-mails are written to storage/logs/laravel.log
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@musafir.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Musafir ---
# Next.js public site (used for redirects, CORS, Sanctum and on-demand revalidation)
FRONTEND_URL=http://localhost:3000
# Admin on its own host (e.g. admin.musafir.com.bd) — leave empty to serve it at APP_URL/ADMIN_PATH
ADMIN_DOMAIN=
ADMIN_PATH=admin
# Staff roles that must use an authenticator app (e.g. owner,finance); anyone can opt in from My profile
ADMIN_2FA_REQUIRED_ROLES=
# Sign staff out after this many idle minutes (0 = off)
ADMIN_IDLE_MINUTES=120
# Must equal REVALIDATE_SECRET in frontend/.env.local (also lets SSR calls skip API rate limits)
REVALIDATE_SECRET=local-dev-secret-change-me
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
# Payments: sandbox | live ; SMS (OTP): log | ssl_wireless | bulksmsbd
PAYMENT_MODE=sandbox
# Local only: the sign-in code is returned by the API (and shown on the sign-in page) so you can test without SMS.
OTP_DEBUG=true
SMS_DRIVER=log

# Portal API rate limit (requests/min per traveller)
ME_RATE_PER_MIN=240

# Proxy IPs/CIDRs in front of the app (comma list), or * on PaaS/CDN
TRUSTED_PROXIES=127.0.0.1
